{
  "type": "record",
  "name": "LinkRawUpdateEvent",
  "namespace": "backend.academy.linktracker.avro",
  "doc": "Raw event for link update notifications (input to AI Agent)",
  "fields": [
    {
      "name": "id",
      "type": "long",
      "doc": "Link ID"
    },
    {
      "name": "url",
      "type": "string",
      "doc": "Link URL"
    },
    {
      "name": "description",
      "type": "string",
      "doc": "Update description"
    },
    {
      "name": "author",
      "type": "string",
      "doc": "Author of the update"
    },
    {
      "name": "tgChatIds",
      "type": {
        "type": "array",
        "items": "long"
      },
      "doc": "Telegram chat IDs to notify"
    }
  ]
}