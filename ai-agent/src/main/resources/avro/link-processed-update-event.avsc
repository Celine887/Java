{
  "type": "record",
  "name": "LinkProcessedUpdateEvent",
  "namespace": "backend.academy.linktracker.avro",
  "doc": "Processed event for link update notifications (output from AI Agent)",
  "fields": [
    {
      "name": "id",
      "type": "long",
      "doc": "Link ID"
    },
    {
      "name": "description",
      "type": "string",
      "doc": "Processed (possibly summarized) description"
    },
    {
      "name": "tgChatIds",
      "type": {
        "type": "array",
        "items": "long"
      },
      "doc": "Telegram chat IDs to notify"
    },
    {
      "name": "priority",
      "type": "string",
      "doc": "Priority level (HIGH, MEDIUM, LOW)"
    }
  ]
}